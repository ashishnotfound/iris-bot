# =============================================================================
# HERMES CLOUD TELEGRAM AGENT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Set these environment variables in Vercel / Cloud Provider Settings.
# DO NOT COMMIT REAL API KEYS TO PUBLIC GIT REPOSITORIES.

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT SECURITY & CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Bot token created via @BotFather on Telegram (Bot: @IrisOpusBot)
TELEGRAM_BOT_TOKEN=8916712872:AAGPR875g-RrxX-1iwKsLORjS0p2Oifg5jE

# Whitelisted numeric Telegram User/Chat IDs allowed to interact with the bot.
# Obtain your ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_id_here

# Secret token for Telegram webhook validation (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# -----------------------------------------------------------------------------
# 2. COMPOSIO API & INTEGRATIONS
# -----------------------------------------------------------------------------
# Composio API Key for 1000+ app integrations (Gmail, Google Calendar, Google Maps, etc.)
COMPOSIO_API_KEY=ak__AA-tGzwmasbekb-rhC-

# -----------------------------------------------------------------------------
# 3. AI MODEL PROVIDERS (GENUINELY FREE TIERS)
# -----------------------------------------------------------------------------
# Google AI Studio (Gemini 2.5 Flash / 1.5 Flash) - Genuinely Free Tier
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Model string
DEFAULT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 4. SUPABASE PERSISTENT STATE & STORAGE
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# 5. TERMINAL EXECUTION & CLOUD SANDBOX
# -----------------------------------------------------------------------------
TERMINAL_BACKEND=vercel_sandbox
VERCEL_SANDBOX_TOKEN=your_vercel_sandbox_token_here

# -----------------------------------------------------------------------------
# 6. OPENROUTER — MULTI-KEY FAILOVER (FREE MODELS AVAILABLE)
# -----------------------------------------------------------------------------
# Get API keys at: https://openrouter.ai/keys
# Free models include: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free
# Add up to 9 keys — the agent auto-rotates and skips exhausted keys.
OPENROUTER_API_KEY=sk-or-your-primary-key-here
# OPENROUTER_API_KEY_2=sk-or-your-second-key-here
# OPENROUTER_API_KEY_3=sk-or-your-third-key-here

# -----------------------------------------------------------------------------
# 7. NVIDIA NIM — FREE INFERENCE CREDITS
# -----------------------------------------------------------------------------
# Get a free API key (includes free credits) at: https://build.nvidia.com
# Models: meta/llama-3.1-405b-instruct, microsoft/phi-3-vision-128k-instruct, etc.
# NVIDIA_API_KEY=nvapi-your-key-here

# -----------------------------------------------------------------------------
# 8. SPEECH-TO-TEXT — GROQ WHISPER (FREE TIER)
# -----------------------------------------------------------------------------
# Get a FREE API key (no credit card required) at: https://console.groq.com
# Used for transcribing voice messages sent to the Telegram bot.
# Model: whisper-large-v3-turbo (fast, highly accurate)
GROQ_API_KEY=your_groq_api_key_here

# Advanced STT overrides (optional — normally managed via config.yaml)
# STT_GROQ_MODEL=whisper-large-v3-turbo

# -----------------------------------------------------------------------------
# 9. DEFAULT LLM PROVIDER & MODEL
# -----------------------------------------------------------------------------
# Provider priority order for automatic failover:
#   gemini → openrouter → nvidia
# Override the default model used for text generation:
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.0-flash-exp

# -----------------------------------------------------------------------------
# 10. CRON JOB SECURITY
# -----------------------------------------------------------------------------
# Random secret to authenticate the /api/cron Vercel endpoint.
# Set this in Vercel → Settings → Environment Variables.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here
