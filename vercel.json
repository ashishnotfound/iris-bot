{
  "functions": {
    "api/webhook.py": {
      "maxDuration": 60
    },
    "api/cron.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.py"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
