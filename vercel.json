{
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["api/lib/**", "api/requirements.txt"]
      }
    },
    {
      "src": "api/cron.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["api/lib/**", "api/requirements.txt"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/api/cron",
      "dest": "/api/cron.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
